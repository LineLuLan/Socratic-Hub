{
  "name": "socratic-hub",
  "version": "0.1.0",
  "private": true,
  "description": "Socratic Hub by Educata — LMS dạy AI Engineer bằng phương pháp Socratic",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
