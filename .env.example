# Socratic Hub — Environment Variables Template
# Copy to .env (gitignored) and fill in real values.

# ─────────────────────────────────────────────
# Sprint 0 — Required
# ─────────────────────────────────────────────

# Postgres (Neon free tier — get at https://console.neon.tech)
# Format: postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL="postgresql://user:password@host.neon.tech/socratic_hub?sslmode=require"

# ─────────────────────────────────────────────
# Sprint 1 — Auth (better-auth)
# ─────────────────────────────────────────────

# Random 32+ char string. Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# ─────────────────────────────────────────────
# Sprint 3 — LLM Proxy (Groq default)
# ─────────────────────────────────────────────

# Get at https://console.groq.com/keys
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"

# ─────────────────────────────────────────────
# Sprint 4 — Fallback LLM + Queue
# ─────────────────────────────────────────────

# Defer until socraticScore < 0.7 fallback needed
ANTHROPIC_API_KEY=""

# Defer until BullMQ worker (S4-02) — Upstash or local
REDIS_URL=""

# ─────────────────────────────────────────────
# Runtime
# ─────────────────────────────────────────────

PORT=4000
NODE_ENV="development"
